# 虚拟环境与缓存
.venv/
__pycache__/
*.py[cod]

# 索引产物：可由 build_vector_store.py 从原始资料重建，不入库
chroma_db/

# 原始资料：体积大且第三方内容，按 README 说明用脚本下载
data/*.pdf
data/*.cdb
data/cards-manifest.json
data/official-qa.jsonl
data/official-qa-manifest.json
data/qa-cache/

# IDE 与本地工具残留
.idea/
.reasonix/
reasonix.toml

# 评测过程中产生的临时文件
eval/results/*.tmp
